# Optional checkout/provider-stage proxies. Leave blank to make direct requests.
OPENAI_PAY_DEFAULT_PROXY=
OPENAI_PAY_PROVIDER_PROXY=
OPENAI_PAY_PIX_PROXY=
OPENAI_PAY_PIX_PROMOTION_PROXY=
OPENAI_PAY_KOREA_PROXY=
OPENAI_PAY_INDIA_PROXY=

# Optional comma/semicolon-separated pools. PIX promotion is the VN stage.
# KR/IN/NL pools are used for both target-region Checkout and provider stages.
OPENAI_PAY_DEFAULT_PROXY_POOL=
OPENAI_PAY_PROVIDER_PROXY_POOL=
OPENAI_PAY_PIX_PROXY_POOL=
OPENAI_PAY_PIX_PROMOTION_PROXY_POOL=
OPENAI_PAY_KOREA_PROXY_POOL=
OPENAI_PAY_INDIA_PROXY_POOL=

# Optional OPLL2 console authentication. Empty values leave the local console open.
OPLL_ADMIN_PASSWORD=
OPLL_AUTH_SECRET=

# Leave disabled for the standalone facade. It never claims accounts from ZC.
OPLL_ZC_BASE_URL=
OPLL_ZC_TOKEN=
OPLL_ZC_PASSWORD=
OPLL_ZC_JWT_SECRET=
